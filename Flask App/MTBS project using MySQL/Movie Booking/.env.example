SECRET_KEY=your-secret-key-here
DB_BACKEND=mysql
ADMIN_EMAIL=your-admin-email@example.com

# Optional: path to SQLite file (default: instance/movie_booking.db)
# SQLITE_PATH=instance/movie_booking.db

# MySQL — set DB_BACKEND=mysql when MySQL is installed
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DB=movie_booking
MYSQL_PORT=3306
